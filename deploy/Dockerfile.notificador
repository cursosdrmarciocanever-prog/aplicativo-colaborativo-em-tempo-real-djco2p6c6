# Serviço de notificações (Web Push). Usa as mesmas regras do app (src/lib) via tsx.
# Os primeiros passos são iguais ao build do web: o Docker reaproveita o cache.
FROM node:22-alpine
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY src/lib ./src/lib
COPY notificador ./notificador
ENV TZ=America/Sao_Paulo
CMD ["pnpm", "exec", "tsx", "notificador/index.ts"]
