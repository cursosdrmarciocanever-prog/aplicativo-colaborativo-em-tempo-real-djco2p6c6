# Copie para deploy/.env (nunca vai para o Git) e preencha.

# Endereço do app (crie um registro DNS tipo A apontando para a VPS)
DIARIO_HOST=diario.clinicacanever.com.br

# Mesmo certresolver do Traefik usado pelo CRM:
#   grep -i certresolver /docker/apps/crm/deploy/.env /docker/apps/financeiro/docker-compose.yml
CERT_RESOLVER=letsencrypt

PB_VERSION=0.36.0

# Envio de e-mail (obrigatório: o login é por código enviado por e-mail).
# Gmail: smtp.gmail.com, porta 587, usuário = seu Gmail, senha = "senha de app"
#   (myaccount.google.com > Segurança > Verificação em duas etapas > Senhas de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Diário da Sarah
